# Copia este fichero a .env y ajusta lo que necesites.
# Todas las variables son opcionales: sin ellas se usan rutas dentro
# del propio proyecto.

# Dónde se guardan los clips descargados y los guiones
# TIKTOK_DATOS_DIR=./datos

# Dónde quedan los vídeos montados y el log
# TIKTOK_SALIDA_DIR=./salida

# Sesión de TikTok exportada del navegador. Sin esto no se publica solo.
# TIKTOK_COOKIES=./datos/cookies.json

# ffmpeg propio; si se omite se usa el de imageio-ffmpeg
# TIKTOK_FFMPEG=

# Fuentes de los subtítulos
# TIKTOK_FUENTE_NEGRITA=C:\Windows\Fonts\arialbd.ttf
# TIKTOK_FUENTE_NORMAL=C:\Windows\Fonts\arial.ttf

# Base de datos para el registro de publicaciones (opcional)
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/simbai
